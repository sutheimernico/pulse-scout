__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.env.*
!.env.example
# Local state / caches (regenerable) — never committed
.cache/
# Raw feed content is third-party copyrighted material — never committed
.cache/raw/
*.db
*.db-journal
# WAL mode (set in store/db.py so the API can read during a run) adds two sidecar files.
*.db-wal
*.db-shm
# Finished digests. Our own prose, but the Kür lines are verbatim third-party headlines,
# and the files are regenerable local output that nothing in git needs.
data/digests/
# Frontend build output
frontend/node_modules/
frontend/dist/
