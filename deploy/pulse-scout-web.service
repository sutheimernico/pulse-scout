# The phone's server: API plus the built PWA on port 8430 (PULSE_DASH_PORT).
# --require-token: refuses to start without PULSE_DASH_TOKEN in .env, because
# `tailscale serve` forwards the tailnet to 127.0.0.1 and a loopback bind alone keeps no one out.
[Unit]
Description=pulse-scout web (API + PWA, token-gated)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/private/pulse-scout
ExecStart=%h/private/pulse-scout/.venv/bin/python scripts/serve.py --require-token
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
