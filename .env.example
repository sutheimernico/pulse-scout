# pulse-scout — copy to .env and fill. Never commit .env.

# --- Local LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Scoring pass: small + fast, runs once per candidate
PULSE_SCORE_MODEL=qwen2.5:1.5b
# Writing pass: the digest itself
PULSE_WRITE_MODEL=qwen2.5:7b
# Embeddings for story threading (stage 2). Pull with: ollama pull nomic-embed-text
PULSE_EMBED_MODEL=nomic-embed-text

# --- Web UI ---
# Shared secret for the phone. Without it the server binds to loopback only.
PULSE_DASH_TOKEN=
PULSE_DASH_PORT=8430

# --- Fetching etiquette ---
PULSE_USER_AGENT=pulse-scout/0.1 (personal daily digest; contact via github)
